{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDirs": [
      ".",
      ".vooya/types"
    ],
    "strict": true,
    "skipLibCheck": false,
    "target": "ES2020",
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    ".vooya/types/**/*.ts"
  ]
}
